# Dependencies
node_modules/
vendor/
vendor-prefixed/
bin/strauss.phar

# Plugin CSS build output
assets/css/dist/

# Source maps and webpack HTML (never commit; regenerated by npm run build)
*.map
assets/js/dist/admin.html

# Commit production bundles and LICENSE files under assets/js/dist/
# Do not ignore assets/js/dist/*.bundle.js

# Common runtime assets: track src/assets/common/js/dist/*.bundle.js + images
# Ignore only build-time common JS source if ever copied locally
src/assets/common/js/src/

# Environment files
.env
.env.local
.env.production

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# WordPress specific
wp-config.php
wp-content/uploads/
wp-content/cache/

# Test / cache / release trees
coverage/
.phpunit.result.cache
tests/wordpress/
wporg/

# Package files
*.zip
*.tar.gz
